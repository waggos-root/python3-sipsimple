+#if V4L2_MJPEG_DECODER
+/* Util: destroy the MJPEG decoder */
+static void vid4lin_stream_destroy_decoder(vid4lin_stream *stream)
+{
+    if (stream->sws_ctx) {
+        sws_freeContext(stream->sws_ctx);
+        stream->sws_ctx = NULL;
+    }
+    av_frame_free(&stream->dec_frame);
+    av_packet_free(&stream->dec_pkt);
+    avcodec_free_context(&stream->dec_ctx);
+    stream->mjpeg = PJ_FALSE;
+}
+
+/* Util: create the MJPEG decoder */
+static pj_status_t vid4lin_stream_create_decoder(vid4lin_stream *stream)
+{
+    const AVCodec *codec;
+
+    codec = avcodec_find_decoder(AV_CODEC_ID_MJPEG);
+    if (codec == NULL)
+        return PJ_ENOTFOUND;
+
+    stream->dec_ctx = avcodec_alloc_context3(codec);
+    stream->dec_pkt = av_packet_alloc();
+    stream->dec_frame = av_frame_alloc();
+    if (!stream->dec_ctx || !stream->dec_pkt || !stream->dec_frame) {
+        vid4lin_stream_destroy_decoder(stream);
+        return PJ_ENOMEM;
+    }
+
+    if (avcodec_open2(stream->dec_ctx, codec, NULL) < 0) {
+        vid4lin_stream_destroy_decoder(stream);
+        return PJMEDIA_EVID_SYSERR;
+    }
+
+    stream->mjpeg = PJ_TRUE;
+    return PJ_SUCCESS;
+}
+
+/* Util: allocate the buffer for the MJPEG frames, after the mmap buffers.
+ * libavcodec may read past the end of its input, so the frames are copied
+ * to a buffer with padding.
+ */
+static void vid4lin_stream_alloc_jpeg_buf(vid4lin_stream *stream)
+{
+    unsigned i, max_len = 0;
+
+    for (i = 0; i < stream->buf_cnt; ++i) {
+        if (stream->buffers[i].length > max_len)
+            max_len = (unsigned)stream->buffers[i].length;
+    }
+    stream->jpeg_buf_size = max_len;
+    stream->jpeg_buf = pj_pool_alloc(stream->pool,
+                                     max_len + AV_INPUT_BUFFER_PADDING_SIZE);
+}
+
+/* Util: decode an MJPEG frame to I420 in the frame buffer */
+static pj_status_t vid4lin_stream_decode_mjpeg(vid4lin_stream *stream,
+                                               const void *data,
+                                               unsigned size,
+                                               pjmedia_frame *frame)
+{
+    const pjmedia_video_format_detail *vfd;
+    AVFrame *pic = stream->dec_frame;
+    struct SwsContext *sws_ctx;
+    pj_uint8_t *dst[4];
+    int dst_stride[4];
+    unsigned w, h, y_size, c_size;
+    int err;
+
+    vfd = pjmedia_format_get_video_format_detail(&stream->param.fmt, PJ_TRUE);
+    w = vfd->size.w;
+    h = vfd->size.h;
+    y_size = w * h;
+    c_size = ((w + 1) / 2) * ((h + 1) / 2);
+
+    if (frame->size < y_size + 2 * c_size)
+        return PJ_ETOOSMALL;
+    if (size > stream->jpeg_buf_size)
+        return PJ_ETOOBIG;
+
+    pj_memcpy(stream->jpeg_buf, data, size);
+    pj_bzero(stream->jpeg_buf + size, AV_INPUT_BUFFER_PADDING_SIZE);
+    stream->dec_pkt->data = stream->jpeg_buf;
+    stream->dec_pkt->size = size;
+
+    err = avcodec_send_packet(stream->dec_ctx, stream->dec_pkt);
+    if (err >= 0)
+        err = avcodec_receive_frame(stream->dec_ctx, pic);
+    if (err < 0) {
+        /* Cameras can send a few broken frames when starting */
+        if (stream->dec_errors++ % 30 == 0) {
+            char errmsg[AV_ERROR_MAX_STRING_SIZE];
+            av_strerror(err, errmsg, sizeof(errmsg));
+            PJ_LOG(4,(THIS_FILE, "Error decoding MJPEG frame from %s: %s",
+                      stream->name, errmsg));
+        }
+        return PJMEDIA_EVID_SYSERR;
+    }
+    stream->dec_errors = 0;
+
+    sws_ctx = sws_getCachedContext(stream->sws_ctx, pic->width, pic->height,
+                                   (enum AVPixelFormat)pic->format, w, h,
+                                   AV_PIX_FMT_YUV420P, SWS_BILINEAR,
+                                   NULL, NULL, NULL);
+    if (sws_ctx == NULL) {
+        av_frame_unref(pic);
+        return PJMEDIA_EVID_SYSERR;
+    }
+    if (sws_ctx != stream->sws_ctx) {
+        /* JPEG uses the full range, also when the decoder reports it in the
+         * frame instead of using a YUVJ pixel format
+         */
+        if (pic->color_range == AVCOL_RANGE_JPEG) {
+            const int *coefs = sws_getCoefficients(SWS_CS_DEFAULT);
+            sws_setColorspaceDetails(sws_ctx, coefs, 1, coefs, 0,
+                                     0, 1 << 16, 1 << 16);
+        }
+        stream->sws_ctx = sws_ctx;
+    }
+
+    dst[0] = (pj_uint8_t*)frame->buf;
+    dst[1] = dst[0] + y_size;
+    dst[2] = dst[1] + c_size;
+    dst[3] = NULL;
+    dst_stride[0] = w;
+    dst_stride[1] = dst_stride[2] = (w + 1) / 2;
+    dst_stride[3] = 0;
+    sws_scale(sws_ctx, (const uint8_t * const *)pic->data, pic->linesize,
+              0, pic->height, dst, dst_stride);
+    av_frame_unref(pic);
+
+    frame->size = y_size + 2 * c_size;
+    return PJ_SUCCESS;
+}
+#endif  /* V4L2_MJPEG_DECODER */
