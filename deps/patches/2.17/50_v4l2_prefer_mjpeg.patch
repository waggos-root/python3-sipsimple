+/* Decode MJPEG with libavcodec rather than libv4l2, which can only decode
+ * frames whose size is a multiple of the JPEG block size (not 1080 lines).
+ */
+#if defined(PJMEDIA_HAS_LIBAVCODEC) && PJMEDIA_HAS_LIBAVCODEC != 0 && \
+    defined(PJMEDIA_HAS_LIBSWSCALE) && PJMEDIA_HAS_LIBSWSCALE != 0
+#   define V4L2_MJPEG_DECODER   1
+#   include <libavcodec/avcodec.h>
+#   include <libswscale/swscale.h>
+#else
+#   define V4L2_MJPEG_DECODER   0
+#endif
+
 #define THIS_FILE               "v4l2_dev.c"
 #define DRIVER_NAME             "v4l2"
 #define V4L2_MAX_DEVS           4
